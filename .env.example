# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
#
# Anything already exported in your shell overrides this file, which is how a
# benchmark run can target one model for one invocation:
#   AISC_LLM_MODEL=gpt-4.1-mini python -m extract_eval.regression.evaluate_regression

# ── LLM (required by the extraction pipeline, API server and benchmark) ───
# Works with Azure OpenAI, api.openai.com, and any OpenAI-compatible server
# (vLLM, Ollama, LM Studio). Leave the endpoint empty to use api.openai.com.
AISC_LLM_ENDPOINT=
AISC_LLM_API_KEY=
AISC_LLM_MODEL=gpt-4o

# ── MISP (only needed for data collection: explore_misp.py) ───────────────
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=false

# ── Optional: push benchmark results to a Google Sheet ────────────────────
AISC_SHEET_ID=
AISC_SHEET_GID=
