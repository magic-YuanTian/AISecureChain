# ── Secrets ──────────────────────────────────────────────────────────────
# .env holds MISP credentials and the LLM endpoint/key. Never commit it.
.env
.env.local
*.pem
*.key

# ── Vendored / cloned upstream repos ─────────────────────────────────────
# Clones of external projects kept for reference, not our code. Together they
# are >6GB; clone them separately rather than committing them here.
cvelistV5/
avid-db/
crawl4ai/
www-project-top-10-for-large-language-model-applications/
mit/

# ── Generated knowledge base ─────────────────────────────────────────────
# Rebuildable: `python build_db.py` then `python build_rdf.py`.
*.db
*.db-wal
*.db-shm
*.bak
*.db.*
query_engine/ai_vuln_kb.ttl

# ── Collected / derived data ─────────────────────────────────────────────
output/
*.png
report.md

# ── Benchmark artifacts ──────────────────────────────────────────────────
# Keep gold.yaml, fixtures/ and the scripts — they ARE the benchmark.
# Drop per-run reports and spreadsheet exports.
query_engine/extract_eval/regression/report_*.json
query_engine/extract_eval/regression/proposed_gold.yaml
query_engine/extract_eval/regression/*.xlsx
query_engine/extract_eval/regression/*.csv
# Keep the Track A link list (source URLs for the active suite).
!query_engine/extract_eval/regression/track_a_links.csv
query_engine/extract_eval/regression/csv/
# Local A/B fixture trees (oracle / LLM-cleaned / raw no-clean / smoke); stock fixtures/ stays tracked.
query_engine/extract_eval/regression/fixtures_oracle/
query_engine/extract_eval/regression/fixtures_llm_cleaned/
query_engine/extract_eval/regression/fixtures_raw/
query_engine/extract_eval/regression/fixtures_hf_smoke/
# Ad-hoc link subset for the footer-clean experiment.
test_links_footer8.csv
query_engine/extract_eval/report*.json
query_engine/extract_eval/bench.json
query_engine/extract_eval/blog_results.json
query_engine/extract_eval/*_results.json
query_engine/track_a_report.json

# ── Local Python venv ────────────────────────────────────────────────────
query_engine/myenv/

# ── Local editor / agent settings ────────────────────────────────────────
# Machine-specific and may embed private ids from past commands.
.claude/
.cursorignore
CLAUDE.md
.aider*
.github/copilot-instructions.md

# ── Local eval reports / working notes ─────────────────────────────────
# Regenerable benchmark dumps, queues, and analysis scratch — keep on disk,
# do not commit.
local_reports/

# ── Working notes, not documentation ─────────────────────────────────────
# Dated work logs, progress summaries and slide decks belong in a notebook,
# not in the repository. Durable docs go in README.md next to what they cover.
UPDATES_*.md
PRESENTATION*.md
*_SUMMARY.md
NOTES.md
TODO.md
sanjay_notes.md

# ── Reference data / derived indexes ─────────────────────────────────────
# The MITRE CWE catalog is an 18MB upstream download, and the embedding index
# is built from it. Fetch and rebuild rather than committing either.
cwec_*.xml
query_engine/data/cwe_faiss/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── Node / frontend ──────────────────────────────────────────────────────
node_modules/
query_engine/frontend/build/
npm-debug.log*

# ── Editors / OS ─────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
