# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
#
# Anything already exported in your shell takes precedence over this file, which
# is how a benchmark run can point at a different model for one invocation:
#   AISC_LLM_MODEL=gpt-4.1-mini python -m extract_eval.regression.evaluate_regression

# ── MISP (only needed for data collection: explore_misp.py) ───────────────
MISP_URL=https://your-misp-instance.example.com
MISP_API_KEY=
MISP_VERIFY_SSL=false

# ── LLM (required by the extraction pipeline, API server and benchmark) ───
# Azure OpenAI by default; set AISC_LLM_PROVIDER=openai for any
# OpenAI-compatible endpoint (vLLM, Ollama, api.openai.com, …).
AISC_LLM_ENDPOINT=https://your-azure-endpoint.example.com/
AISC_LLM_API_KEY=
AISC_LLM_API_VERSION=2024-10-01-preview
AISC_LLM_MODEL=gpt-4o
AISC_LLM_PROVIDER=azure

# Optional. AISC_LLM_MAX_TOKENS caps generation (self-hosted servers often
# default low). AISC_LLM_EXTRA_BODY is passed through as OpenAI `extra_body` for
# vendor-specific switches, e.g. turning off Qwen's default thinking mode:
#   AISC_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# AISC_LLM_MAX_TOKENS=4096
# AISC_LLM_EXTRA_BODY=
